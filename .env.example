# ---------------------------------------------------------------------------
# Database — Neon (Vercel Marketplace → Storage → Create Database → Neon)
# ---------------------------------------------------------------------------
# Pooled connection, used by the app at runtime.
DATABASE_URL="postgresql://user:password@localhost:5432/tennis_court_asenovgrad"
# Direct/unpooled connection, used by Prisma Migrate. A transaction pooler cannot
# hold the advisory locks migrations need. On Neon this is the "unpooled" string.
DIRECT_URL="postgresql://user:password@localhost:5432/tennis_court_asenovgrad"

# ---------------------------------------------------------------------------
# Auth.js — Google SSO
# ---------------------------------------------------------------------------
# Generate with: npx auth secret   (or: openssl rand -base64 32)
AUTH_SECRET=""
# Google Cloud Console → Credentials → OAuth client ID (Web application).
# Authorised redirect URIs must include:
#   http://localhost:3000/api/auth/callback/google
#   https://<your-domain>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# ---------------------------------------------------------------------------
# Email — SendGrid
# ---------------------------------------------------------------------------
# Optional. Without it, confirmation emails are logged to the console instead of
# sent, so local development works without an account.
# SendGrid is used because it can verify a single sender ADDRESS rather than a
# whole domain. Once the club owns a domain, verify that instead for far better
# deliverability — mail from a free provider via a third party often lands in spam.
SENDGRID_API_KEY=""
# Must be exactly the address verified under Single Sender Verification.
# SendGrid rejects anything else with a 403.
SENDGRID_FROM_EMAIL=""
# Display name shown to recipients. Defaults to "Тенис клуб Асеновград".
SENDGRID_FROM_NAME=""

# ---------------------------------------------------------------------------
# Seeding
# ---------------------------------------------------------------------------
# Set this and run `npm run db:seed` to grant that address the ADMIN role. There is
# no "promote to admin" screen in 0.1.0 — this is how the first admin is created.
SEED_ADMIN_EMAIL=""

# ---------------------------------------------------------------------------
# Not used yet — see ROADMAP.md
# ---------------------------------------------------------------------------
# Payments (0.3.0)
# STRIPE_SECRET_KEY=""
# STRIPE_WEBHOOK_SECRET=""
# NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""
# SMS reminders (0.3.0)
# TWILIO_ACCOUNT_SID=""
# TWILIO_AUTH_TOKEN=""
# TWILIO_PHONE_NUMBER=""
