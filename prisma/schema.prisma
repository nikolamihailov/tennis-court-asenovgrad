// Тенис клуб Асеновград — database schema
// Docs: https://pris.ly/d/prisma-schema
//
// Prisma 7 notes:
//   - the `prisma-client` generator requires an explicit `output`
//   - the datasource has no `url`; the connection string lives in prisma7.config.ts

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// TRAINER is granted by an admin to an existing registered account; nobody signs up as one.
enum Role {
  USER
  ADMIN
  TRAINER
}

enum CourtSurface {
  CLAY
  HARD
}

enum BookingStatus {
  CONFIRMED
  CANCELLED
}

/// Who cancelled a booking. Staff could cancel before customers could, so older
/// cancellations are backfilled as CLUB.
enum CancelledBy {
  CUSTOMER
  CLUB
  TRAINER
}

/// One row per person, whether or not they ever sign in.
///
/// Guests who book get a row with `isGuest = true` and no linked Account. Booking again
/// with the same email reuses the row, so a person has one identity and one history. If
/// they later sign in with Google using that address, the sign-in claims this same row.
///
/// `name`, `emailVerified` and `image` are written by the Auth.js Prisma adapter and must
/// stay nullable — the adapter's createUser() only ever sets those four columns, so
/// firstName/lastName cannot be NOT NULL.
model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?

  firstName String?
  lastName  String?
  phone     String?
  role      Role    @default(USER)
  isGuest   Boolean @default(false)

  /// bcrypt hash, set only for accounts registered with email and password. Null for
  /// guests and for people who only ever sign in with Google, so its presence is also
  /// what tells the Credentials provider whether password sign-in is possible at all.
  passwordHash String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  accounts Account[]
  sessions Session[]
  bookings Booking[]

  trainerProfile   TrainerProfile?
  trainingBookings Booking[]        @relation("TrainerBookings")

  @@index([role])
  @@index([createdAt])
}

/// A bookable court. Opening hours are plain integers (8 -> 22) in Europe/Sofia local
/// time; there is no separate schedule table until per-day hours are actually needed.
///
/// A booking lasts 60, 90 or 120 minutes, and each length has its own price rather than
/// a per-hour rate times duration — clubs usually discount the longer games, and the
/// admin sets all three.
model Court {
  id          String       @id @default(cuid())
  name        String
  surface     CourtSurface @default(CLAY)
  isIndoor    Boolean      @default(false)
  price60     Decimal      @db.Decimal(10, 2)
  price90     Decimal      @db.Decimal(10, 2)
  price120    Decimal      @db.Decimal(10, 2)
  description String?
  imageUrl    String?
  openingHour Int          @default(8)
  closingHour Int          @default(22)
  isActive    Boolean      @default(true)
  sortOrder   Int          @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  bookings Booking[]

  @@index([isActive, sortOrder])
}

/// A reservation. `userId` is never null — see the User docblock for why guests get a row.
///
/// Overlapping CONFIRMED bookings on the same court are rejected by a btree_gist EXCLUDE
/// constraint added in the `booking_overlap_exclusion` migration, not by application code.
/// Prisma's schema language cannot express that constraint, so it lives in raw SQL.
model Booking {
  id         String        @id @default(cuid())
  reference  String        @unique
  courtId    String
  userId     String
  startsAt   DateTime      @db.Timestamptz(3)
  endsAt     DateTime      @db.Timestamptz(3)
  status     BookingStatus @default(CONFIRMED)
  notes      String?

  /// Rented rackets, 0..MAX_RACKETS. Charged per racket per booking.
  racketCount Int @default(0)

  /// Floodlights. Only offered, and only charged, on outdoor courts.
  lighting Boolean @default(false)

  /// Total actually charged, in euro. Stored rather than recomputed so that changing a
  /// court's price later does not silently rewrite the history of what people paid.
  totalPrice Decimal @db.Decimal(10, 2)

  /// True when created through the guest flow, so admin can tell it apart from a
  /// booking made by a signed-in user who happens to also have isGuest history.
  bookedAsGuest Boolean @default(false)

  cancelledAt        DateTime?
  cancellationReason String?
  cancelledBy        CancelledBy?

  /// SHA-256 of the secret in the "manage your booking" email link. Only the hash is kept,
  /// so reading the database is not enough to cancel someone's booking. Rotated on every
  /// reschedule, since the new confirmation email carries a new link. Null for bookings
  /// made before self-service existed; those can still be managed from the profile.
  manageTokenHash String?

  /// Set when the customer moved the booking to another time.
  rescheduledAt DateTime?

  /// The trainer booked along with the court, if any. A trainer cannot be in two places at
  /// once: the `Booking_trainer_no_overlap` exclusion constraint (raw SQL, like the court
  /// one) rejects overlapping CONFIRMED bookings for the same trainer.
  trainerId String?

  /// The trainer's fee included in `totalPrice`, stored for the same reason as the total:
  /// a later change to the trainer's rate must not rewrite what was charged.
  trainerFee Decimal? @db.Decimal(10, 2)

  /// True when the trainer entered the booking for a student — typically someone who
  /// phoned them and has no account or no internet. Such a student may have no email; see
  /// src/lib/contact.ts for how that is stored.
  bookedByTrainer Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  court   Court @relation(fields: [courtId], references: [id], onDelete: Restrict)
  user    User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  trainer User? @relation("TrainerBookings", fields: [trainerId], references: [id], onDelete: Restrict)

  @@index([trainerId, startsAt])
  @@index([courtId, startsAt])
  @@index([userId, startsAt])
  @@index([startsAt])
  @@index([status, startsAt])
}

/// Trainer-specific data, for a User whose role is TRAINER.
///
/// Kept when the role is revoked (with `isActive = false`) so that re-granting it later
/// restores the trainer's hours and bio instead of starting from nothing, and so past
/// bookings still point at a trainer with a name.
model TrainerProfile {
  userId String @id

  /// Shown to customers on the booking page. Written by the trainer.
  bio String?

  /// Fee per hour of training, in euro, on top of the court price. Set by the admin.
  /// A 90-minute session costs 1.5 × this.
  hourlyRate Decimal @db.Decimal(10, 2)

  /// False once the role is revoked: hidden from customers and not bookable.
  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user     User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  hours    TrainerWorkingHours[]
  timeOffs TrainerTimeOff[]
}

/// One weekly window when a trainer takes sessions, e.g. Monday 16:00–20:00. A day can
/// have several windows (a lunch break is two). Europe/Sofia local time, like court hours.
model TrainerWorkingHours {
  id          String @id @default(cuid())
  trainerId   String
  /// ISO weekday: 1 = Monday … 7 = Sunday.
  weekday     Int
  /// Minutes since club-local midnight, on the 30-minute grid.
  startMinute Int
  endMinute   Int

  trainer TrainerProfile @relation(fields: [trainerId], references: [userId], onDelete: Cascade)

  @@index([trainerId, weekday])
}

/// A block when the trainer is unavailable despite their weekly hours: holiday, illness,
/// a tournament. Stored as instants so a multi-day absence is one row.
model TrainerTimeOff {
  id        String   @id @default(cuid())
  trainerId String
  startsAt  DateTime @db.Timestamptz(3)
  endsAt    DateTime @db.Timestamptz(3)
  reason    String?

  createdAt DateTime @default(now())

  trainer TrainerProfile @relation(fields: [trainerId], references: [userId], onDelete: Cascade)

  @@index([trainerId, startsAt])
}

// ---------------------------------------------------------------------------
// Auth.js (NextAuth) tables. Shapes are dictated by @auth/prisma-adapter.
// Authenticator/WebAuthn is intentionally omitted — the only provider is Google.
// ---------------------------------------------------------------------------

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
}

/// Unused while the session strategy is "jwt" (see src/auth.ts), but kept so switching
/// to database sessions is a config change rather than a migration.
model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}
